{
  "info": {
    "_postman_id": "projects-crud-baziz",
    "name": "B Aziz - Projects CRUD",
    "description": "Complete CRUD API for managing renovation, maintenance, and construction projects. Set apiBase and accessToken in environment variables before testing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('apiBase')) pm.environment.set('apiBase', 'http://localhost:5000/api/v1');"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "apiBase",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "projectId",
      "value": "",
      "type": "string"
    },
    {
      "key": "propertyId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create Project",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Project created', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "  const body = pm.response.json();",
              "  const data = body.data;",
              "  if (data && (data._id || data.id)) {",
              "    pm.environment.set('projectId', data._id || data.id);",
              "  }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Kitchen Renovation - Oak Street\",\n  \"description\": \"Complete kitchen renovation with new cabinets, countertops, and appliances\",\n  \"address\": \"123 Oak Street, Manchester\",\n  \"type\": \"renovation\",\n  \"priority\": \"high\",\n  \"status\": \"planning\",\n  \"budget\": 25000,\n  \"contingency\": 5000,\n  \"startDate\": \"2024-01-15\",\n  \"endDate\": \"2024-03-15\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{apiBase}}/projects",
          "host": [
            "{{apiBase}}"
          ],
          "path": [
            "projects"
          ]
        }
      },
      "response": []
    },
    {
      "name": "List All Projects",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{apiBase}}/projects?skip=0&limit=10",
          "host": [
            "{{apiBase}}"
          ],
          "path": [
            "projects"
          ],
          "query": [
            {
              "key": "skip",
              "value": "0"
            },
            {
              "key": "limit",
              "value": "10"
            },
            {
              "key": "status",
              "value": "planning",
              "disabled": true
            },
            {
              "key": "priority",
              "value": "high",
              "disabled": true
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Project By ID",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{apiBase}}/projects/{{projectId}}",
          "host": [
            "{{apiBase}}"
          ],
          "path": [
            "projects",
            "{{projectId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Projects by Property",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{apiBase}}/projects/property/{{propertyId}}?skip=0&limit=10",
          "host": [
            "{{apiBase}}"
          ],
          "path": [
            "projects",
            "property",
            "{{propertyId}}"
          ],
          "query": [
            {
              "key": "skip",
              "value": "0"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Projects by Status",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{apiBase}}/projects/status/planning?skip=0&limit=10",
          "host": [
            "{{apiBase}}"
          ],
          "path": [
            "projects",
            "status",
            "planning"
          ],
          "query": [
            {
              "key": "skip",
              "value": "0"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Update Project",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"in-progress\",\n  \"actualStartDate\": \"2024-01-10\",\n  \"priority\": \"urgent\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{apiBase}}/projects/{{projectId}}",
          "host": [
            "{{apiBase}}"
          ],
          "path": [
            "projects",
            "{{projectId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Delete Project",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{apiBase}}/projects/{{projectId}}",
          "host": [
            "{{apiBase}}"
          ],
          "path": [
            "projects",
            "{{projectId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Project Statistics",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{apiBase}}/projects/stats/overview?propertyId={{propertyId}}",
          "host": [
            "{{apiBase}}"
          ],
          "path": [
            "projects",
            "stats",
            "overview"
          ],
          "query": [
            {
              "key": "propertyId",
              "value": "{{propertyId}}",
              "disabled": true
            }
          ]
        }
      },
      "response": []
    }
  ]
}
